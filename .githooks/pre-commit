#!/usr/bin/env bash
# .githooks/pre-commit — 在 commit 涉及受控檔案時跑機械化檢查
#
# 啟用：git config core.hooksPath .githooks

set -uo pipefail

# 只在 commit 觸及這些路徑時跑（跑全套檢查很快，但避免每次無關 commit 都跑）
TRIGGER_PATTERNS=(
    "^wiki/"
    "^raw/"
    "^prompts/"
    "^CLAUDE\.md$"
    "^AGENTS\.md$"
    "^README\.md$"
    "^scripts/check-consistency\.sh$"
)

# 取得本次 commit 要動的檔案
CHANGED=$(git diff --cached --name-only --diff-filter=ACMR)

should_run=0
for f in $CHANGED; do
    for pattern in "${TRIGGER_PATTERNS[@]}"; do
        if [[ "$f" =~ $pattern ]]; then
            should_run=1
            break 2
        fi
    done
done

if [[ $should_run -eq 0 ]]; then
    exit 0
fi

echo ">>> pre-commit: 觸及受控檔案，跑 scripts/check-consistency.sh"
echo

if bash scripts/check-consistency.sh; then
    exit 0
else
    echo
    echo ">>> pre-commit 阻擋：請修上面列出的問題，或用 \`git commit --no-verify\` 強推（不建議）。"
    exit 1
fi
